      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <link name="cutter_blades_link">
      <pose>0.2 0 -0.1 0 0 0</pose>
      <visual name="cutter_blades_marker_visual">
        <pose>0.8 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>.20 .01 .15</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0 0 1</ambient>
